# StayScout environment configuration
# Copy this file to ".env" and fill in your key. The .env file is gitignored.

# Google Maps API key — sent to the BROWSER for the Maps JavaScript API and
# Places Autocomplete (address search). Because this key is visible to anyone
# using the app, restrict it in Google Cloud Console under "Application
# restrictions" > HTTP referrers, locked to your actual domain(s).
# Enable in Google Cloud: Maps JavaScript API, Places API.
GOOGLE_MAPS_API_KEY=

# Optional: a SEPARATE key used server-side for travel-time (Distance Matrix)
# calculations. Distance Matrix is called directly from this server, not a
# browser, so it has no Referer header — an HTTP-referrer-restricted key (like
# the one above) gets rejected with "API keys with referer restrictions cannot
# be used with this API." If unset, falls back to GOOGLE_MAPS_API_KEY, which
# only works if that key has no referrer restriction (not recommended once
# it's restricted for the browser use case above).
# Enable in Google Cloud: Distance Matrix API. Restrict by IP address (your
# server's IP) instead of HTTP referrer, or leave unrestricted if IP is
# unknown/dynamic — either way, only Distance Matrix is enabled on it, so the
# blast radius of exposure is minimal even unrestricted.
# GOOGLE_MAPS_SERVER_KEY=

# Optional: change the port the server listens on (defaults to 5173).
# PORT=5173

# Set to "false" on a shared/public deployment to stop anyone from removing
# listings through the app or its API — voting still works normally. Defaults
# to "true" (removal allowed), matching local single-user behavior.
# ALLOW_REMOVE_LISTINGS=false

# Set to "false" to stop anyone from editing a listing's price, nights,
# guests, bedrooms, beds, or baths through the app or its API — everything
# else (photos, cached images, travel times, votes) still updates normally.
# Defaults to "true" (editing allowed).
# ALLOW_EDIT_LISTINGS=false

# Cloudflare Tunnel token (only used by `docker compose up`, for the
# cloudflared service). Create a tunnel in the Cloudflare Zero Trust
# dashboard (Networks > Tunnels), set its public hostname to point at
# service http://app:5173, then paste the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=
