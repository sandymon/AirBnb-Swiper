{
  "manifest_version": 3,
  "name": "StayScout Scraper",
  "version": "1.12",
  "description": "Extract stay information from Airbnb listings and send to StayScout.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://*/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
